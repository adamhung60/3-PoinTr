<mujoco model="xarm7 openfridge scene">
  <!-- Include the base scene with robot arm -->
  <include file="base.xml"/>

  <!-- Don't override meshdir - base.xml needs its meshdir for robot meshes -->
  <!-- Instead, use full relative paths for fridge meshes -->
  <asset>
    <!-- Fridge frame meshes - full paths relative to this XML file location -->
    <!-- Paths resolve relative to simulation_assets/scenes/ -->
    <mesh name="frame_mesh_0" file="../../objects/fridge/textured_objs/new-0.obj"/>
    <mesh name="frame_mesh_3" file="../../objects/fridge/textured_objs/new-3.obj"/>
    
    <!-- Door meshes -->
    <mesh name="door_leaf_2" file="../../objects/fridge/textured_objs/original-2.obj"/>
    <mesh name="door_leaf_3" file="../../objects/fridge/textured_objs/original-3.obj"/>
    <mesh name="door_leaf_4" file="../../objects/fridge/textured_objs/original-4.obj"/>
    <mesh name="door_frame_mesh" file="../../objects/fridge/textured_objs/new-2.obj"/>
    <mesh name="door_handle_mesh" file="../../objects/fridge/textured_objs/new-1.obj"/>
  </asset>

  <worldbody>
    <!-- Fridge base body (fixed to world) -->
    <!-- Position fridge in front of robot arm -->
    <body name="fridge_base" pos="0.5 0.5 0">
      <!-- Fridge frame (link_0) - fixed joint with rotation -->
      <!-- URDF joint_0: rpy="1.570796326794897 0 -1.570796326794897" = (90°, 0°, -90°) -->
      <body name="fridge_frame" euler="1.5708 0 -1.5708">
        <!-- Frame geoms -->
        <geom name="frame_geom_0" type="mesh" mesh="frame_mesh_0" contype="1" conaffinity="1"/>
        <geom name="frame_geom_3" type="mesh" mesh="frame_mesh_3" contype="1" conaffinity="1"/>
        
        <!-- Door (link_1) - revolute joint -->
        <!-- Joint origin relative to parent (link_0): xyz="0.41948741391591016 0.77081 0.4619671850171603" -->
        <!-- Joint axis: xyz="0 1 0" (rotation around Y axis) -->
        <!-- Joint limits: lower="0.0" upper="3.141592653589793" (0 to π radians = 0 to 180 degrees) -->
        <body name="fridge_door" pos="0.41948741391591016 0.77081 0.4619671850171603">
          <joint name="door_joint" type="hinge" axis="0 1 0" range="0 3.14159" damping="0.1"/>
          
          <!-- Door geoms with offset relative to door body -->
          <!-- Visual/collision offset: xyz="-0.41948741391591016 -0.77081 -0.4619671850171603" -->
          <geom name="door_leaf_2" type="mesh" mesh="door_leaf_2" pos="-0.41948741391591016 -0.77081 -0.4619671850171603" contype="1" conaffinity="1"/>
          <geom name="door_leaf_3" type="mesh" mesh="door_leaf_3" pos="-0.41948741391591016 -0.77081 -0.4619671850171603" contype="1" conaffinity="1"/>
          <geom name="door_leaf_4" type="mesh" mesh="door_leaf_4" pos="-0.41948741391591016 -0.77081 -0.4619671850171603" contype="1" conaffinity="1"/>
          <geom name="door_frame_geom" type="mesh" mesh="door_frame_mesh" pos="-0.41948741391591016 -0.77081 -0.4619671850171603" contype="1" conaffinity="1"/>
          <geom name="door_handle_geom" type="mesh" mesh="door_handle_mesh" pos="-0.41948741391591016 -0.77081 -0.4619671850171603" contype="1" conaffinity="1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <keyframe>
    <!-- Home keyframe with qpos for arm (7) + gripper (6) + door joint (1) = 14 total -->
    <!-- Door joint starts at 0 (closed) -->
    <key name="home" qpos="0 -.247 0 .909 0 1.15644 0 0 0 0 0 0 0 0" ctrl="0 -.247 0 .909 0 1.15644 0 0"/>
    <key name="scene_home" qpos="0 -.247 0 .909 0 1.15644 0 0 0 0 0 0 0 0" ctrl="0 -.247 0 .909 0 1.15644 0 0"/>
  </keyframe>
</mujoco>
