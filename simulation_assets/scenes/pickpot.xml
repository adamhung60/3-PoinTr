<mujoco model="xarm7 pickpot scene">
  <!-- Include the base scene with robot arm -->
  <include file="base.xml"/>

  <!-- Override physics timestep -->
  <!-- <option timestep="0.002"/> -->

  <!-- Don't override meshdir - base.xml needs its meshdir for robot meshes -->
  <!-- MuJoCo resolves mesh paths relative to the meshdir set in base.xml (../ufactory_xarm7/assets) -->
  <!-- So paths must be relative to that meshdir, not to this XML file -->
  <!-- From meshdir (simulation_assets/ufactory_xarm7/assets), pot STLs are at ../../objects/pot/ -->
  <asset>
    <!-- Pot aluminum texture - path relative to this XML file -->
    <texture name="pot_aluminum_texture" type="2d" file="../objects/pot/aluminum.png" width="128" height="128"/>
    
    <!-- Material that references the texture -->
    <material name="pot_aluminum_material" texture="pot_aluminum_texture" texuniform="true"/>
    
    <!-- Pot meshes - paths relative to meshdir (../ufactory_xarm7/assets) -->
    <!-- Pot bottom mesh - STL is in millimeters, scale by 0.001 to convert to meters -->
    <mesh name="pot_mesh" file="../../objects/pot/pot.stl" scale="0.001 0.001 0.001"/>
    <!-- Pot lid mesh - STL is in millimeters, scale by 0.001 to convert to meters -->
    <mesh name="lid_mesh" file="../../objects/pot/lid.stl" scale="0.001 0.001 0.001"/>
    <!-- Pot handle mesh - STL is in millimeters, scale by 0.001 to convert to meters -->
    <mesh name="handle_mesh" file="../../objects/pot/handle.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <!-- global geom defaults (floor, pot, etc) -->
    <geom 
      density="2000"
      solref="0.003 2.0"  
    />

  </default>
  <!-- margin="0.001" -->
  <!-- solimp="0.7 0.9 0.01"    -->


  <worldbody>
    <!-- Pot base body (with free joint for randomization) -->
    <!-- Position pot in front of robot arm -->
    <!-- After scaling mesh by 0.001, pot should sit on ground at z=0.1 -->
    <body name="pot_base" pos="0.8 0.0 0.0">
      <freejoint/>
      <geom name="pot_geom" type="mesh" mesh="pot_mesh" material="pot_aluminum_material" contype="1" conaffinity="1"/>
    </body>
    
    <!-- Pot lid body (with free joint so it can be picked up) -->
    <!-- Position lid on the ground beside the pot -->
    <!-- Placed to the right (positive Y) of the pot, slightly forward -->
    <body name="lid_base" pos="0.8 0.15 -10.02">
      <freejoint/>
      <geom name="lid_geom" type="mesh" mesh="lid_mesh" material="pot_aluminum_material" contype="1" conaffinity="1"/>
      <!-- Handle body rigidly attached to lid -->
      <!-- Position relative to lid - adjust pos if handle needs offset from lid origin -->
      <!-- No joint needed - child bodies without joints are automatically fixed to parent -->
      <body name="handle_base" pos="0 0 0">
        <geom name="handle_geom" type="mesh" mesh="handle_mesh" material="pot_aluminum_material" contype="1" conaffinity="1" density="500"/>
        <geom name="handle_geom_proxy" type="box" pos="0 0 0.175" size="0.043 0.015 0.015" contype="1" conaffinity="1" friction="3.0 0.1 0.01" rgba="0 0 0 0"/>
      </body>
    </body>
  </worldbody>

  <keyframe>
    <key name="scene_home" qpos="0 -.247 0 .909 0 1.15644 0 0 0 0 0 0 0 0.425 -0.125 0.0 1 0 0 0 0.425 0.125 -0.12 1 0 0 0" ctrl="0 -.247 0 .909 0 1.15644 0 0"/>
  </keyframe>
</mujoco>
