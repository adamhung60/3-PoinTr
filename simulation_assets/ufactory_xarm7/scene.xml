<mujoco model="xarm7 scene">
  <include file="xarm7.xml"/>

  <statistic center="0.2 0 0.4" extent=".65"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <geom type="cylinder" size=".06 .06" pos="0 0 .06" rgba="1 1 1 1"/>
    
    <!-- Front camera: position and orientation from MuJoCo viewer -->
    <!-- <camera name="front" pos="1.051 0.220 1.137" xyaxes="-0.183 0.983 0.000 -0.756 -0.140 0.640"/> -->

    <camera name="front" pos="0.829 -0.013 0.832" xyaxes="-0.001 1.000 -0.000 -0.836 -0.000 0.548"/>

    
    <!-- Green box (large, side length 0.2) -->
    <body name="green_box" pos="0.3 0.2 0.1">
      <freejoint/>
      <geom name="green_box_geom" type="box" size="0.05 0.05 0.05" rgba="0 1 0 1" mass="0.1"/>
    </body>
    
    <!-- Blue box (small, side length 0.1) -->
    <body name="blue_box" pos="0.25 -0.15 0.05">
      <freejoint/>
      <geom name="blue_box_geom" type="box" size="0.03 0.03 0.03" rgba="0 0 1 1" mass="0.05"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- Home keyframe with qpos for arm (7) + gripper (6) + green_box (7) + blue_box (7) = 27 total -->
    <!-- Arm and gripper qpos from xarm7.xml: 0 -.247 0 .909 0 1.15644 0 0 0 0 0 0 0 -->
    <!-- Green box: pos (0.3 0.2 0.1) quat (1 0 0 0) -->
    <!-- Blue box: pos (0.25 -0.15 0.05) quat (1 0 0 0) -->
    <key name="home" qpos="0 -.247 0 .909 0 1.15644 0 0 0 0 0 0 0 0.3 0.2 0.1 1 0 0 0 0.25 -0.15 0.05 1 0 0 0" ctrl="0 -.247 0 .909 0 1.15644 0 0"/>
    <key name="scene_home" qpos="0 -.247 0 .909 0 1.15644 0 0 0 0 0 0 0 0.3 0.2 0.1 1 0 0 0 0.25 -0.15 0.05 1 0 0 0" ctrl="0 -.247 0 .909 0 1.15644 0 0"/>
  </keyframe>
</mujoco>
